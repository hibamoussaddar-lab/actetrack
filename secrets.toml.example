# Copiez ce fichier vers .streamlit/secrets.toml et remplissez avec vos VRAIS identifiants.
# Ne committez JAMAIS secrets.toml dans git (voir .gitignore fourni).
#
# Recommandation sécurité : créez un utilisateur MySQL dédié en LECTURE SEULE
# pour cette appli plutôt que d'utiliser "root" :
#   CREATE USER 'actetrack_ro'@'%' IDENTIFIED BY 'un_mot_de_passe_different_et_fort';
#   GRANT SELECT ON webman_tmp.* TO 'actetrack_ro'@'%';
#   GRANT SELECT ON webman_users.* TO 'actetrack_ro'@'%';
#   FLUSH PRIVILEGES;

[db]
user = "actetrack_ro"
password = "remplacez_moi"
host = "localhost"
port = 3306
